# Local SQLite database
JOBPILOT_DB_PATH=data/jobpilot.db
JOBPILOT_SEARCH_CONFIG=config/job_search.json
CANDIDATE_PROFILE_PATH=data/candidate_profile.json
VERIFIED_ANSWERS_PATH=data/verified_answers.json

# HTTP behavior
HTTP_TIMEOUT_SECONDS=25
HTTP_MAX_RETRIES=3
HTTP_USER_AGENT=JobPilotAI/0.2 (personal local job discovery)

# Remotive recommends no more than four API requests per day.
# 6 hours = at most four scheduled fetches per day.
REMOTIVE_MIN_INTERVAL_HOURS=6
ARBEITNOW_MIN_INTERVAL_HOURS=6
ATS_MIN_INTERVAL_HOURS=24

# Arbeitnow pagination and minimum deterministic match score
ARBEITNOW_MAX_PAGES=10
MIN_JOB_MATCH_SCORE=40

# Optional Gemini evaluation. Without a key, eligible jobs remain pending.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_RETRIES=3

# Browser/application behavior: safe review mode is the default.
APPLICATION_MODE=review
AUTO_APPLY_ENABLED=false
MAX_APPLICATIONS_PER_DAY=5
MAX_APPLICATIONS_PER_COMPANY_PER_DAY=2

# Optional read-only Gmail integration; requires local OAuth client credentials.
GMAIL_ENABLED=false
GMAIL_OAUTH_CLIENT_FILE=data/gmail_oauth_client.json
GMAIL_SEARCH_QUERY=newer_than:14d
GMAIL_MAX_MESSAGES=100
GMAIL_POLL_INTERVAL_MINUTES=20
GEMINI_EMAIL_CLASSIFICATION_ENABLED=false

# Local agent and notification behavior.
NOTIFICATIONS_ENABLED=true
AGENT_DISCOVERY_INTERVAL_HOURS=6
AGENT_EVALUATION_INTERVAL_HOURS=6
